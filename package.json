{
  "name": "thinking-canvas",
  "version": "0.1.0",
  "description": "AI conversation interface with particle-based thinking visualization",
  "main": "server.js",
  "author": "Ben Serota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenSerota/thinking-canvas.git"
  },
  "scripts": {
    "start": "node server.js",
    "fetch-icons": "node scripts/fetch-icons.js",
    "build-embeddings": "node scripts/build-embeddings.js",
    "fetch-emoji": "node scripts/fetch-emoji.js",
    "build-emoji-embeddings": "node scripts/build-emoji-embeddings.js",
    "generate-lottie": "node scripts/generate-lottie-assets.js",
    "setup-icons": "npm run fetch-icons && npm run build-embeddings",
    "setup-emoji": "npm run fetch-emoji && npm run build-emoji-embeddings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@xenova/transformers": "^2.17.2",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.6.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "lottie-web": "^5.13.0",
    "svg-path-properties": "^1.3.0"
  },
  "overrides": {
    "protobufjs": ">=7.5.5"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@material-symbols/svg-400": "^0.44.1"
  }
}
